{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuralmarket:contract:pilot_portal_attestation:1.3",
  "title": "Pilot portal cost attestation",
  "description": "Short-lived manual operator record of Databento portal facts for the bound pilot scope. A completed artifact records either the exact displayed request estimate or explicitly that no request estimate was displayed. Historical numeric v1 artifacts without portal_estimate_status retain their original displayed-estimate meaning. The optional source_evidence block binds sanitized portal-account facts (billing cycle, displayed usage, balance, credits, limit, remaining capacity) to a hashed local source file; a bounded display such as \"<$0.01\" is recorded verbatim with a relation and its exact Decimal bound rather than an invented value. An account billed on a rolling basis records billing_cycle_basis=rolling with both cycle bounds absent, rather than inventing dates the portal never displayed. Explicitly binds to the approved repository revision. Complements (does not replace) the execution-layer portal_limit_attestation. Never stores portal cookies, account identifiers, credentials, or screenshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_only",
    "attested",
    "repository_head",
    "dataset_scope",
    "schema_scope",
    "symbol_scope",
    "window_start",
    "window_end",
    "portal_estimate_usd",
    "currency",
    "observed_at",
    "expires_at",
    "completed_checkpoint_sha256",
    "request_manifest_sha256",
    "operator_confirmation",
    "attestation_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "pilot-portal-attestation-v1"
    },
    "template_only": {
      "type": "boolean"
    },
    "attested": {
      "type": "boolean"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dataset_scope": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "schema_scope": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "symbol_scope": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "portal_estimate_usd": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "portal_estimate_status": {
      "type": "string",
      "enum": ["displayed", "not_displayed"]
    },
    "currency": {
      "const": "USD"
    },
    "observed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completed_checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator_confirmation": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "attestation_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "observed_at",
        "timezone",
        "billing_cycle_basis",
        "usage_display_text",
        "usage_relation",
        "usage_amount_usd",
        "currency",
        "configured_limit_usd",
        "source_evidence_sha256",
        "source_reference",
        "source_classification",
        "reviewer",
        "review_method",
        "expires_at"
      ],
      "properties": {
        "contract_version": {"const": "portal-source-evidence-v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1},
        "billing_cycle_basis": {"type": "string", "enum": ["dated", "rolling"]},
        "billing_cycle_start": {"type": ["string", "null"], "format": "date-time"},
        "billing_cycle_end": {"type": ["string", "null"], "format": "date-time"},
        "usage_display_text": {"type": "string", "minLength": 1},
        "usage_relation": {"type": "string", "enum": ["exact", "lt", "lte"]},
        "usage_amount_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "currency": {"const": "USD"},
        "configured_limit_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "account_balance_usd": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
        "remaining_credits_usd": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
        "remaining_available_usd": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
        "source_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_reference": {"type": "string", "minLength": 1},
        "source_classification": {
          "type": "string",
          "enum": ["sanitized_screenshot", "sanitized_written_attestation"]
        },
        "reviewer": {"type": "string", "minLength": 1},
        "review_method": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["template_only"],
        "properties": {"template_only": {"const": true}}
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["portal_estimate_status"]},
            {"required": ["source_evidence"]}
          ]
        },
        "properties": {
          "attested": {"const": false},
          "portal_estimate_usd": {"type": "null"},
          "operator_confirmation": {"type": "null"},
          "observed_at": {"type": "null"},
          "expires_at": {"type": "null"},
          "attestation_hash": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "attested": {"const": true},
          "operator_confirmation": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "attestation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "oneOf": [
          {
            "not": {"required": ["portal_estimate_status"]},
            "properties": {
              "portal_estimate_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
            }
          },
          {
            "required": ["portal_estimate_status"],
            "properties": {
              "portal_estimate_status": {"const": "displayed"},
              "portal_estimate_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
            }
          },
          {
            "required": ["portal_estimate_status"],
            "properties": {
              "portal_estimate_status": {"const": "not_displayed"},
              "portal_estimate_usd": {"type": "null"}
            }
          }
        ]
      }
    }
  ]
}
